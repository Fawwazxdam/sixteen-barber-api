# Application Configuration
NODE_ENV=development
APP_PORT=4001

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# JWT Configuration
JWT_SECRET=your-very-strong-secret-key-min-32-characters-long

# CORS Configuration
FRONTEND_URL=http://localhost:3000,https://next-barber-phi.vercel.app

# Notes:
# - For development: NODE_ENV=development
# - For production: NODE_ENV=production
# - When NODE_ENV=production:
#   - sameSite will be 'none'
#   - secure will be true
#   - partitioned will be true (for CHIPS compliance)
# - When NODE_ENV=development:
#   - sameSite will be 'lax'
#   - secure will be false
#   - partitioned will be false
